# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# App
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Session/Auth (set at least one; SESSION_SECRET preferred)
SESSION_SECRET=replace_with_a_long_random_secret_min_24_chars
NEXTAUTH_SECRET=replace_with_a_long_random_secret_min_24_chars
OAUTH_STATE_SECRET=replace_with_a_long_random_secret_min_24_chars

# Mercado Libre
ML_CLIENT_ID=replace_ml_client_id
ML_CLIENT_SECRET=replace_ml_client_secret
ML_REDIRECT_URI=http://localhost:3000/api/ml/callback
ML_WEBHOOK_SECRET=replace_ml_webhook_secret

# Telegram
TELEGRAM_BOT_TOKEN=replace_telegram_bot_token
TELEGRAM_BOT_USERNAME=replace_telegram_bot_username
TELEGRAM_WEBHOOK_SECRET=replace_telegram_webhook_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_PRICE_ID=price_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_TRIAL_DAYS=7
STRIPE_WEBHOOK_EVENT_RETENTION_DAYS=30
STRIPE_WEBHOOK_ENDPOINT_ID=we_optional_for_manual_reference

# Email (Gmail SMTP for early testing)
EMAIL_FROM="MercadoLibs <yourgmail@gmail.com>"
SUPPORT_EMAIL=yourgmail@gmail.com
GMAIL_SMTP_USER=yourgmail@gmail.com
GMAIL_SMTP_APP_PASSWORD="replace_google_app_password"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_upstash_rest_token
RATE_LIMIT_STRICT_MODE=true

# Jobs/Schedulers
RECONCILE_CRON_SECRET=replace_reconcile_secret
RECONCILE_BASE_URL=http://localhost:3000
ORDERS_CLEANUP_CRON_SECRET=replace_orders_cleanup_secret
# ORDERS_CLEANUP_ALLOWED_IPS=1.2.3.4,5.6.7.8
# ORDERS_CLEANUP_BASE_URL=http://localhost:3000

# Labels
ORDER_LABEL_TOKEN_SECRET=replace_label_token_secret
