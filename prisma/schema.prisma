generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  mlUserId         String   @unique
  mlNickname       String?
  mlAvatarUrl      String?
  stripeCustomerId String?  @unique
  accessToken      String
  refreshToken     String
  tokenExpiresAt   DateTime
  createdAt        DateTime @default(now())

  telegramAccount       TelegramAccount?
  notificationSettings  NotificationSettings?
  telegramConnectTokens TelegramConnectToken[]
  mlWebhookEvents       MlWebhookEvent[]
  items                 Item[]
  orders                Order[]
  feedbackEntries       Feedback[]
  billingSubscription   BillingSubscription?
  emailDeliveries       EmailDelivery[]
}

model TelegramAccount {
  id     String @id @default(cuid())
  userId String @unique
  chatId String
  user   User   @relation(fields: [userId], references: [id])
}

model TelegramConnectToken {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, usedAt, expiresAt])
}

model Item {
  id                String    @id @default(cuid())
  userId            String
  mlItemId          String
  name              String
  stock             Int
  threshold         Int
  lowStockAlertedAt DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])

  @@unique([userId, mlItemId])
}

model MlWebhookEvent {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  userId    String?
  mlUserId  String?
  topic     String?
  resource  String?
  action    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model NotificationSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  notifyEverySale   Boolean  @default(true)
  notifySoldOut     Boolean  @default(true)
  notifyLowStock    Boolean  @default(true)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model Order {
  id            String                 @id @default(cuid())
  userId        String
  mlOrderId     String
  status        String
  totalAmount   Decimal?
  saleType      String?
  createdAtMl   DateTime?
  updatedAtMl   DateTime?
  lastSeenAt    DateTime               @default(now())
  expiresAt     DateTime
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id])
  lines         OrderLine[]
  notifications OrderNotificationLog[]

  @@unique([userId, mlOrderId])
  @@index([userId, createdAtMl])
  @@index([userId, status])
  @@index([expiresAt])
}

model OrderLine {
  id        String   @id @default(cuid())
  orderId   String
  mlItemId  String
  title     String
  quantity  Int
  unitPrice Decimal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([mlItemId])
}

model OrderNotificationLog {
  id        String   @id @default(cuid())
  orderId   String
  channel   String   @default("telegram")
  eventType String
  status    String
  reason    String?
  payload   Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model ReconcileJobLock {
  name          String    @id
  ownerId       String?
  lockedAt      DateTime?
  lockExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ReconcileRun {
  id                 String    @id @default(cuid())
  status             String
  triggerSource      String?
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  durationMs         Int?
  usersProcessed     Int?
  usersFailed        Int?
  itemsChecked       Int?
  itemsUpdated       Int?
  soldOutAlertsSent  Int?
  lowStockAlertsSent Int?
  errorMessage       String?

  @@index([startedAt])
  @@index([status, startedAt])
}

model BillingSubscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  status               String
  degradedSince        DateTime?
  priceId              String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  latestInvoiceId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id])

  @@index([status, currentPeriodEnd])
  @@index([degradedSince])
}

model StripeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String
  message   String
  pagePath  String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@index([createdAt])
}

model EmailDelivery {
  id                String    @id @default(cuid())
  userId            String
  type              String
  dedupeKey         String
  recipient         String
  subject           String
  status            String
  providerMessageId String?
  error             String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  user              User      @relation(fields: [userId], references: [id])

  @@unique([userId, type, dedupeKey])
  @@index([status, createdAt])
  @@index([type, createdAt])
}
